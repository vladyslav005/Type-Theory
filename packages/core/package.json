{
  "name": "@vladyslav005/tt-core",
  "version": "0.6.5",
  "description": "Pure TypeScript library for parsing, type-checking, and evaluating Simply Typed Lambda Calculus with proof tree visualization",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladyslav005/tt/tree/main/packages/core"
  },
  "homepage": "https://github.com/vladyslav005/tt/tree/main/packages/core",
  "keywords": [
    "lambda-calculus",
    "type-checker",
    "stlc",
    "parser",
    "proof-tree",
    "curry-howard",
    "evaluator",
    "typescript"
  ],
  "author": {
    "name": "Vladyslav Futrak",
    "email": "vladyslav.futrak@student.tuke.sk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "gen-grammar": "bash gen_lang_proc.sh",
    "prepublishOnly": "npm run build",
    "release": "npm version patch --tag-version-prefix=core-v -m \"chore(core): release core-v%s\"",
    "release:minor": "npm version minor --tag-version-prefix=core-v -m \"chore(core): release core-v%s\"",
    "release:major": "npm version major --tag-version-prefix=core-v -m \"chore(core): release core-v%s\""
  },
  "dependencies": {
    "antlr4": "^4.13.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.9.3"
  }
}
