{
  "name": "@vladyslav005/tt-web",
  "private": true,
  "license": "MIT",
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && node scripts/gen-lecture-pdfs.mjs && node scripts/gen-merged-guide.mjs",
    "build:app": "npm run check:i18n && npm run gen:sitemap && tsc -b && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:lecture-pdfs": "npm run build:app && node scripts/gen-lecture-pdfs.mjs && node scripts/gen-merged-guide.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "release": "npm version patch --tag-version-prefix=web-v -m \"chore(web): release web-v%s\"",
    "release:minor": "npm version minor --tag-version-prefix=web-v -m \"chore(web): release web-v%s\"",
    "release:major": "npm version major --tag-version-prefix=web-v -m \"chore(web): release web-v%s\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vladyslav005/tt-core": "*",
    "@xyflow/react": "^12.10.1",
    "better-react-mathjax": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.34.3",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.12",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.11.0",
    "puppeteer-core": "^25.11.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
