{
  "name": "tt-vscode-extension",
  "displayName": "Type Theory (tt)",
  "description": "Syntax highlighting, diagnostics, completions, and interactive AST/proof-tree/evaluation panels for the tt (typed lambda calculus) language.",
  "version": "0.0.9",
  "license": "MIT",
  "publisher": "vladyslav005",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladyslav005/tt/tree/main/apps/vscode-extension"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Visualization"
  ],
  "keywords": [
    "lambda calculus",
    "type theory",
    "simply typed lambda calculus",
    "stlc",
    "type checker",
    "type checking",
    "proof tree",
    "curry-howard",
    "formal methods",
    "type system",
    "tt"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run check-types:webview && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:tsc:webview": "tsc --noEmit --watch --project tsconfig.webview.json",
    "package": "npm run check-types && npm run check-types:webview && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "check-types:webview": "tsc --noEmit --project tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "release": "npm version patch --tag-version-prefix=vscode-v -m \"chore(extension): release vscode-v%s\"",
    "release:minor": "npm version minor --tag-version-prefix=vscode-v -m \"chore(extension): release vscode-v%s\"",
    "release:major": "npm version major --tag-version-prefix=vscode-v -m \"chore(extension): release vscode-v%s\""
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "@vladyslav005/tt-core": "*",
    "d3-hierarchy": "^3.1.2",
    "d3-zoom": "^3.0.0",
    "d3-selection": "^3.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-zoom": "^3.0.8",
    "@types/d3-selection": "^3.0.11"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "contributes": {
    "configuration": {
      "title": "TT",
      "properties": {
        "tt.typeTheories.letPolymorphism": {
          "type": "boolean",
          "default": false,
          "description": "Generalize let-bound values (Hindley-Milner) so they can be reused at different types."
        },
        "tt.typeTheories.typeInference": {
          "type": "boolean",
          "default": false,
          "description": "Allow omitting a lambda's parameter type anywhere; it's inferred from how the parameter is used (always allowed inside a let-bound value)."
        },
        "tt.typeTheories.isoRecursiveTypes": {
          "type": "boolean",
          "default": false,
          "description": "Self-referential types (μX.T) introduced/eliminated explicitly via fold/unfold, isomorphic (not equal) to their one-step unfolding."
        },
        "tt.typeTheories.systemF": {
          "type": "boolean",
          "default": false,
          "description": "Explicit polymorphism via type abstraction (ΛX. t) and type application (t [T])."
        },
        "tt.typeTheories.systemFOmega": {
          "type": "boolean",
          "default": false,
          "description": "Types abstracted over types (λX:K. T) and applied to a type argument (F T), classified by kinds instead of just types."
        },
        "tt.typeTheories.systemLambdaP": {
          "type": "boolean",
          "default": false,
          "description": "Types that depend on terms via Π-types (Πx:A.M, of which A→B is the non-dependent special case), and kinds indexed by a type."
        },
        "tt.typeTheories.untyped": {
          "type": "boolean",
          "default": false,
          "description": "Only variables, abstraction, and application are allowed — everything else is rejected. Enabling it disables every other type theory extension."
        },
        "tt.evaluationStrategy": {
          "type": "string",
          "enum": [
            "NORMAL",
            "CALL_BY_VALUE",
            "CALL_BY_NAME"
          ],
          "enumDescriptions": [
            "Normal Order",
            "Call by value",
            "Call by name"
          ],
          "default": "CALL_BY_VALUE",
          "description": "Reduction strategy used by \"TT: Evaluate Current File\" and the Evaluation Steps panel."
        }
      }
    },
    "commands": [
      {
        "command": "tt-vscode-extension.parseCurrentFile",
        "title": "TT: Parse Current File"
      },
      {
        "command": "tt-vscode-extension.toggleTypeTheories",
        "title": "TT: Toggle Type Theories"
      },
      {
        "command": "tt-vscode-extension.chooseEvaluationStrategy",
        "title": "TT: Choose Evaluation Strategy"
      },
      {
        "command": "tt-vscode-extension.evaluateCurrentFile",
        "title": "TT: Evaluate Current File"
      },
      {
        "command": "tt-vscode-extension.showEvaluationSteps",
        "title": "TT: Show Evaluation Steps"
      },
      {
        "command": "tt-vscode-extension.showProofTree",
        "title": "TT: Show Proof Tree"
      },
      {
        "command": "tt-vscode-extension.showAstGraph",
        "title": "TT: Show AST Diagram"
      },
      {
        "command": "tt-vscode-extension.exportProofTreeLatex",
        "title": "TT: Export Proof Tree as LaTeX"
      }
    ],
    "languages": [
      {
        "id": "tt",
        "aliases": [
          "TT",
          "tt"
        ],
        "extensions": [
          ".tt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tt",
        "scopeName": "source.tt",
        "path": "./syntaxes/tt.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "TT Light",
        "uiTheme": "vs",
        "path": "./themes/tt-light-color-theme.json"
      },
      {
        "label": "TT Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/tt-dark-color-theme.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ttAstView",
          "name": "TT AST",
          "when": "tt.activeFileIsTt",
          "icon": "$(list-tree)"
        }
      ]
    }
  }
}
