{
  "name": "tt",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:core": "npm run build --workspace=@vladyslav005/tt-core",
    "build:web": "npm run build --workspace=@vladyslav005/tt-web",
    "build": "npm run build:core && npm run build:web",
    "release:core": "npm run release --workspace=@vladyslav005/tt-core",
    "release:core:minor": "npm run release:minor --workspace=@vladyslav005/tt-core",
    "release:core:major": "npm run release:major --workspace=@vladyslav005/tt-core",
    "release:web": "bash scripts/release-web.sh patch",
    "release:web:minor": "bash scripts/release-web.sh minor",
    "release:web:major": "bash scripts/release-web.sh major",
    "package:extension": "npm run vsce:package --workspace=tt-vscode-extension",
    "release:extension": "npm run release --workspace=tt-vscode-extension",
    "release:extension:minor": "npm run release:minor --workspace=tt-vscode-extension",
    "release:extension:major": "npm run release:major --workspace=tt-vscode-extension",
    "release:all": "bash scripts/release-all.sh",
    "dev": "npm run dev --workspace=@vladyslav005/tt-web",
    "lint": "npm run lint --workspace=@vladyslav005/tt-web",
    "preview": "npm run preview --workspace=@vladyslav005/tt-web"
  },
  "workspaces": [
    "apps/web",
    "apps/vscode-extension",
    "packages/*"
  ],
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "typescript": "~5.9.3"
  }
}
